{
  "entity": {
    "sensor": {
      "next_job": {
        "default": "mdi:clock-outline"
      },
      "pending_jobs": {
        "default": "mdi:format-list-numbered"
      }
    },
    "todo": {
      "scheduled": {
        "default": "mdi:clock-check-outline"
      }
    }
  },
  "services": {
    "schedule": {
      "service": "mdi:clock-plus-outline"
    },
    "list": {
      "service": "mdi:format-list-bulleted"
    },
    "cancel": {
      "service": "mdi:clock-remove-outline"
    },
    "run_now": {
      "service": "mdi:play-circle-outline"
    },
    "clear_history": {
      "service": "mdi:delete-sweep-outline"
    }
  }
}
